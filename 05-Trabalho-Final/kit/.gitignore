# Diretorio de trabalho do terraform init (providers baixados, backend local).
# Cada job do pipeline recria com init; versionar so incharia o repositorio.
.terraform/

# State e plan nunca vao para o Git: o state vive no S3 (backend) e o plan e
# artefato do pipeline, gerado e consumido dentro do mesmo pipeline.
*.tfstate
*.tfstate.*
*.tfplan
plan-*.json

# Zip do app gerado pelo modulo app-release no plan (artefato do job plan-<env>).
build/

# Relatorios JUnit gerados pelo pytest e pelo Checkov no pipeline.
contrato-*.xml
smoke-*.xml
observabilidade-*.xml
rag-quality-gate.xml
rag-quality-gate.json
checkov-report.xml

.pytest_cache/
__pycache__/
*.pyc

# O .terraform.lock.hcl NAO entra aqui de proposito. Versionado, ele fixa a mesma
# versao dos providers no Codespaces e no runner, e e o que liga o cache de
# providers do pipeline (TF_PLUGIN_CACHE_DIR).

# Zip da entrega (passo 28): gerado na raiz do clone, nao pode ser commitado.
*.zip
